# .gitignore for Campus Care project
# Dependencies
node_modules/
backend/node_modules/

# Build output
/dist/
backend/dist/

# Local PostgreSQL Data & Uploads
backend/.pgdata/
backend/uploads/

# Local environment variables
.env
.env.local
.env.*
backend/.env
backend/.env.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS files
.DS_Store
Thumbs.db

# Vite & TS cache
/.vite
*.tsbuildinfo

# Binaries
cloudflared.exe
*.exe


